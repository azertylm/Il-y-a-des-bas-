# Clé Gemini du serveur. Sans elle, l'application démarre en mode secours
# local et le signale dans l'interface. Ne jamais versionner la vraie valeur.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port d'écoute (défaut 3000). La plupart des hébergeurs l'imposent.
# PORT=3000

# Chemin du fichier d'archives. À faire pointer vers un disque persistant en
# production, sinon les archives disparaissent à chaque déploiement.
# ARCHIVES_FILE=/data/archives.json

# Identifiants de modèles. Défauts définis dans l'objet MODELS de server.ts.
# MODEL_GEMINI=gemini-3.5-flash
# MODEL_OPENAI=gpt-4o-mini
# MODEL_ANTHROPIC=claude-3-5-haiku-20241022
# MODEL_DEEPSEEK=deepseek-chat
# MODEL_MISTRAL=mistral-large-latest
# MODEL_GROK=grok-2-1212

# Route les appels Gemini vers une passerelle interne ou un bouchon de test.
# GEMINI_BASE_URL=https://exemple.interne/gemini

# Limite de débit par client et reprise sur 429.
# RATE_LIMIT_MAX=40
# RATE_LIMIT_WINDOW_MS=60000
# GENERATION_MAX_RETRIES=2
